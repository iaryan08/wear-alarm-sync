<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ══════════════════════════════════════════════════════════════
         PERMISSIONS
         ══════════════════════════════════════════════════════════════ -->

    <!-- Standard normal permission — auto-granted, no user prompt needed -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Required to receive NEXT_ALARM_CLOCK_CHANGED implicit broadcast on Android 8+ -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery optimisation exemption must be requested at runtime or granted via ADB:
         adb shell dumpsys deviceidle whitelist +dev.sync.alarm -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- DUMP is a signature/privileged permission — granted once via ADB:
         adb shell pm grant dev.sync.alarm android.permission.DUMP -->
    <uses-permission android:name="android.permission.DUMP" />

    <!-- POST_NOTIFICATIONS needed on Android 13+ for any notification we post -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ══════════════════════════════════════════════════════════════
         APPLICATION
         ══════════════════════════════════════════════════════════════ -->
    <application
        android:name="dev.sync.phone.PhoneApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlarmSync"
        tools:targetApi="35">

        <!-- ── Main Activity ── -->
        <activity
            android:name="dev.sync.phone.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AlarmSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Alarm Change Broadcast Receiver ──
             Wakes instantly when AlarmManager's next alarm changes. -->
        <receiver
            android:name="dev.sync.phone.receiver.PhoneAlarmChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.ALARM_CHANGED" />
                <action android:name="oplus.intent.action.OPLUS_NEW_ALARMCLOCK_INSERTED" />
                <action android:name="com.oplus.alarmclock.alarmclock.SET_NEXT_ALERT" />
            </intent-filter>
        </receiver>

        <!-- ── Notification Action Click Receiver (Dismiss / Snooze from phone for watch alarm) ── -->
        <receiver
            android:name="dev.sync.phone.receiver.PhoneAlarmActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.sync.phone.action.DISMISS" />
                <action android:name="dev.sync.phone.action.SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- ── Notification Listener Service ──
             Captures active alarm notifications to extract Dismiss/Snooze PendingIntents.
             Must be granted via Settings → Special App Access → Notification Access,
             or via: adb shell cmd notification allow_listener dev.sync.alarm/… -->
        <service
            android:name="dev.sync.phone.notification.PhoneAlarmNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── Wearable Data Listener Service ──
             Passive service that Google Play Services wakes when a Wearable message
             arrives from the Watch. Zero battery cost when idle. -->
        <service
            android:name="dev.sync.phone.service.PhoneWearDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/alarm"
                    android:scheme="wear" />
            </intent-filter>
        </service>

    </application>

</manifest>
